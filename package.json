		"eslint-plugin-solid": "^0.14.0",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.32.0",
		"oxlint": "^1.47.0",
		"tailwindcss": "^4.1.18",
		"tsgo": "^0.9.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.6",
