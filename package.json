{
  "name": "solid-app-template",
  "version": "0.0.1",
  "private": true,
  "description": "Fullstack SolidJS template with fastest frontend tooling.",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git://github.com/heyhuynhgiabuu/solid-app-template.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "cd client && pnpm dev",
    "dev:server": "cd server && pnpm dev",
    "dev:setup": "cd server && pnpm prisma generate",
    "format": "oxfmt",
    "lint": "oxlint .",
    "lint:format": "oxfmt --check .",
    "preinstall": "command -v git >/dev/null 2>&1 && git config core.hooksPath git-hooks || exit 0",
    "prisma": "cd server && pnpm prisma",
    "test": "npm-run-all --parallel tsc:check vitest:run lint lint:format",
    "tsc:check": "tsgo",
    "vitest:run": "vitest run"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^1.0.1",
    "@types/node": "^22.15.0",
    "@typescript/native-preview": "7.0.0-dev.20260212.1",
    "dotenv": "^16.5.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "tsdown": "^0.12.5",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
